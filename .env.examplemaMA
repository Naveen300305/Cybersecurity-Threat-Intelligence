# Neo4j
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=changeme-please

# LLM backend (Graph RAG synthesis + Cypher generation)
# Get a free key at: https://aistudio.google.com/apikey
GOOGLE_API_KEY= your_google_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# NVD API (optional but recommended - raises rate limit from 5 to 50 req/30s)
NVD_API_KEY=

# Ingestion limits (MVP defaults - keep small for a fast local demo)
NVD_CVE_LOOKBACK_DAYS=90
NVD_CVE_MAX_RESULTS=500

# ── Module 11: Asset Monitoring & Alerting ──────────────────────────────────
# How often the background scanner runs (hours); default: 24
SCAN_INTERVAL_HOURS=24

# Slack incoming webhook for CRITICAL/HIGH alerts (optional)
SLACK_WEBHOOK_URL=

# Generic HTTP webhook for alert payloads (optional)
ALERT_WEBHOOK_URL=

# Email delivery via SMTP (optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
ALERT_EMAIL_TO=
